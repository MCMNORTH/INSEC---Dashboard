rules_version = '2';

// Pièces administratives et documents financiers : dépôt direct depuis le navigateur, puis
// enregistrement et téléchargement uniquement via les Cloud Functions (journalisés).
service firebase.storage {
  match /b/{bucket}/o {
    function admin() {
      return request.auth != null && request.auth.token.get('role', '') in ['admin', 'super_admin'];
    }
    function finance() {
      return request.auth != null && request.auth.token.get('role', '') in ['admin', 'super_admin', 'finance'];
    }

    match /dossiers/{etudiantId}/{fichier} {
      allow create: if admin()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
      allow read, update, delete: if false;
    }

    // Documents financiers annuels : PDF déposé par la finance dans son propre dossier,
    // enregistré via enregistrerDocumentFinancier, téléchargé via telechargerDocumentFinancier (journalisé).
    match /finances/{anneeId}/{type}/{uid}/{fichier} {
      allow create: if finance()
        && request.auth.uid == uid
        && type in ['facture-intec', 'justificatif-paiement']
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow read, update, delete: if false;
    }

    match /{chemin=**} {
      allow read, write: if false;
    }
  }
}
