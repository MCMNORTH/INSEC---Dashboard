rules_version = '2';

// Toutes les écritures métier passent par les Cloud Functions (validation, transactions, audit).
// Le navigateur ne dispose que d'accès en lecture, réservés à l'équipe INSEC selon le rôle porté
// par le jeton (custom claim role), à l'exception de l'état lu/archivé de ses propres alertes.
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() { return request.auth != null; }
    function profil() { return /databases/$(database)/documents/utilisateurs/$(request.auth.uid); }
    // Rôle et état lus dans le profil, que seul le serveur écrit : un changement de rôle ou une désactivation
    // s'appliquent immédiatement, sans attendre l'expiration du jeton. Le rôle du jeton sert de repli
    // pour un ancien profil sans rôle ; sans profil, ou compte désactivé, aucun accès.
    function role() {
      return !connecte() || !exists(profil()) ? ''
        : get(profil()).data.get('actif', true) != true ? ''
        : get(profil()).data.get('role', request.auth.token.get('role', ''));
    }
    // Tout ce que voit l'administration ; « admin_lecture » voit les mêmes données qu'un administrateur, sans rien modifier.
    function visionAdmin() { return role() in ['admin', 'super_admin', 'admin_lecture']; }
    // Lecture seule des étudiants et des finances (« consultation » et « admin_lecture » ne modifient rien).
    function lecture() { return role() in ['admin', 'super_admin', 'admin_lecture', 'finance', 'consultation']; }

    // Référentiel des diplômes, UE et années scolaires.
    match /formations/{id} { allow read: if lecture(); }
    match /annees/{id} { allow read: if lecture(); }
    match /ues/{id} { allow read: if lecture(); }

    match /etudiants/{id} { allow read: if lecture(); }
    match /inscriptions/{id} { allow read: if lecture(); }
    match /versements/{id} { allow read: if lecture(); }

    match /examens/{id} { allow read: if visionAdmin(); }
    // Les résultats figurent sur la fiche de l'étudiant.
    match /resultats/{id} { allow read: if lecture(); }
    match /resultatsHistoriques/{id} { allow read: if visionAdmin(); }

    match /pieces/{id} { allow read: if visionAdmin(); }

    match /utilisateurs/{uid} {
      allow read: if visionAdmin() || (connecte() && request.auth.uid == uid);

      match /alertes/{cle} {
        allow read: if connecte() && request.auth.uid == uid;
        // Seuls les champs de lecture et d'archivage peuvent être modifiés, avec l'heure du serveur.
        allow update: if connecte() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lueLe', 'archiveeLe'])
          && (!('lueLe' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lueLe == request.time)
          && (!('archiveeLe' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.archiveeLe == request.time);
      }
    }

    match /journalEmails/{id} { allow read: if visionAdmin(); }
    match /journalAudit/{id} { allow read: if visionAdmin(); }
    match /sauvegardes/{id} { allow read: if role() == 'super_admin'; }

    // Collections techniques (unicité, compteurs) : jamais exposées.
    match /{document=**} { allow read, write: if false; }
  }
}
