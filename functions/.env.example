# Copier en functions/.env.<id-du-projet> avant `firebase deploy`.
# Le mot de passe SMTP est un secret : firebase functions:secrets:set SMTP_PASSWORD
APP_URL=https://dashboard.insec.mr
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@insec.mr
MAIL_FROM_ADDRESS=contact@insec.mr
MAIL_FROM_NAME=INSEC
# Bucket dédié aux sauvegardes (vide = <projet>-sauvegardes)
BACKUP_BUCKET=
