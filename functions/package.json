{
    "name": "insec-functions",
    "private": true,
    "type": "module",
    "main": "lib/index.js",
    "engines": {
        "node": "22"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "firebase emulators:exec --project demo-insec --only auth,firestore,storage \"vitest run\"",
        "amorcer": "npm run build && node lib/scripts/amorcer.js",
        "amorcer:local": "npm run build && FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 GCLOUD_PROJECT=demo-insec SUPER_ADMIN_EMAIL=superadmin@insec.test SUPER_ADMIN_NOM='Super Admin' node lib/scripts/amorcer.js --demo"
    },
    "dependencies": {
        "@google-cloud/firestore": "^9.4.0",
        "exceljs": "^4.4.0",
        "firebase-admin": "^14.5.0",
        "firebase-functions": "^7.4.0",
        "nodemailer": "^10.2.1",
        "pdfmake": "^0.3.12",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^6.0.0",
        "@types/node": "^26.6.5",
        "@types/nodemailer": "^8.0.2",
        "@vue/tsconfig": "^0.9.1",
        "firebase": "^13.1.0",
        "typescript": "~7.0",
        "vitest": "^5.0.5"
    }
}

