rules_version = '2';

// Toutes les écritures métier passent par les Cloud Functions (validation, transactions, audit).
// Le navigateur ne dispose que d'accès en lecture, réservés à l'équipe INSEC selon le rôle porté
// par le jeton (custom claim role), à l'exception de l'état lu/archivé de ses propres alertes.
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() { return request.auth != null; }
    function role() { return connecte() ? request.auth.token.get('role', '') : ''; }
    function admin() { return role() in ['admin', 'super_admin']; }
    function finance() { return role() in ['admin', 'super_admin', 'finance']; }

    // Référentiel des diplômes, UE et années scolaires.
    match /formations/{id} { allow read: if finance(); }
    match /annees/{id} { allow read: if finance(); }
    match /ues/{id} { allow read: if finance(); }

    match /etudiants/{id} { allow read: if finance(); }
    match /inscriptions/{id} { allow read: if finance(); }
    match /versements/{id} { allow read: if finance(); }

    match /examens/{id} { allow read: if admin(); }
    match /resultats/{id} { allow read: if admin(); }
    match /resultatsHistoriques/{id} { allow read: if admin(); }

    match /pieces/{id} { allow read: if admin(); }

    match /utilisateurs/{uid} {
      allow read: if admin() || (connecte() && request.auth.uid == uid);

      match /alertes/{cle} {
        allow read: if connecte() && request.auth.uid == uid;
        // Seuls les champs de lecture et d'archivage peuvent être modifiés, avec l'heure du serveur.
        allow update: if connecte() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lueLe', 'archiveeLe'])
          && (!('lueLe' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.lueLe == request.time)
          && (!('archiveeLe' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.archiveeLe == request.time);
      }
    }

    match /journalEmails/{id} { allow read: if admin(); }
    match /journalAudit/{id} { allow read: if admin(); }
    match /sauvegardes/{id} { allow read: if role() == 'super_admin'; }

    // Collections techniques (unicité, compteurs) : jamais exposées.
    match /{document=**} { allow read, write: if false; }
  }
}
