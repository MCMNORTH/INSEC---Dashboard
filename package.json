{
    "name": "insec-dashboard",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "typecheck": "vue-tsc --noEmit",
        "emulateurs": "npm --prefix functions run build && firebase emulators:start --project demo-insec --only auth,firestore,storage,functions",
        "amorcer:local": "npm --prefix functions run amorcer:local"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.3.1",
        "chart.js": "^4.5.1",
        "firebase": "^12.19.0",
        "pdfjs-dist": "^6.3.289",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^22.20.4",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/tsconfig": "^0.9.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.9",
        "vite": "^8.3.1",
        "vue-tsc": "^3.3.11"
    }
}