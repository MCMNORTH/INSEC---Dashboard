{
    "name": "insec-dashboard",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "typecheck": "vue-tsc --noEmit",
        "test": "npm --prefix functions test",
        "emulateurs": "npm --prefix functions run build && firebase emulators:start --project demo-insec --only auth,firestore,storage,functions",
        "amorcer:local": "npm --prefix functions run amorcer:local"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.3.1",
        "chart.js": "^4.6.1",
        "firebase": "^13.2.0",
        "pdfjs-dist": "^6.5.438",
        "vue": "^3.5.45",
        "vue-router": "^5.4.0"
    },
    "overrides": {
        "@firebase/firestore": {
            "@grpc/grpc-js": "^1.13.6"
        }
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.4",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/tsconfig": "^0.9.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~7.0",
        "vite": "^8.3.6",
        "vue-tsc": "^3.3.14"
    }
}

