# ─── Base de données PostgreSQL (Neon recommandé sur Vercel) ───────────────────
# Utilisez l'URL « pooled » fournie par Neon (sslmode=require).
DATABASE_URL=postgres://utilisateur:motdepasse@hote/insec?sslmode=require

# ─── Sécurité ──────────────────────────────────────────────────────────────────
# Chaîne aléatoire d'au moins 32 caractères (ex. : openssl rand -base64 48).
AUTH_SECRET=
# Durée d'inactivité avant déconnexion, en minutes.
SESSION_LIFETIME=120
# Secret que Vercel Cron envoie à /api/cron/sauvegarde (Vercel le fournit automatiquement si défini).
CRON_SECRET=

# ─── Application ───────────────────────────────────────────────────────────────
APP_URL=https://dashboard.insec.mr
APP_TIMEZONE=Africa/Nouakchott
BACKUP_RETENTION_DAYS=30

# ─── E-mails (SMTP) — sans SMTP_HOST, les e-mails sont journalisés « En attente » ─
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=contact@insec.mr
MAIL_FROM_NAME=INSEC

# ─── Stockage des fichiers (pièces administratives et sauvegardes) ─────────────
# database : fichiers stockés dans PostgreSQL (simple, mais sauvegardes dans la même base)
# s3       : bucket privé compatible S3 (Cloudflare R2, Backblaze B2, AWS S3…) — recommandé
STORAGE_DRIVER=database
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
