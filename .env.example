# Facultatif : sur Firebase Hosting, la configuration est chargée automatiquement (/__/firebase/init.json).
# À renseigner uniquement pour un hébergement hors Firebase ou pour viser un projet réel depuis `npm run dev`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# true = utiliser les émulateurs locaux (par défaut en développement sans configuration)
VITE_UTILISER_EMULATEURS=
